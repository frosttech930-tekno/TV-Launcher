<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:clipChildren="false">

    <!-- Tinted to the focused app's color; shows until movie artwork loads. -->
    <View
        android:id="@+id/ambient_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Two stacked backdrops that HeroCarousel cross-fades between. -->
    <ImageView
        android:id="@+id/hero_image_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/hero_image_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <!-- Darkens the bottom and left so the dock and movie text stay readable on any artwork. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_bottom" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_left" />

    <View
        android:id="@+id/dock_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#B3050507" />

    <!-- 48dp / 27dp margins keep everything inside the TV-safe area on projectors with overscan. -->
    <LinearLayout
        android:id="@+id/hero_text"
        android:layout_width="640dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="250dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="2"
            android:shadowColor="#99000000"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="@color/text_primary"
            android:textSize="46sp" />

        <TextView
            android:id="@+id/hero_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/hero_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingExtra="3dp"
            android:maxLines="3"
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="27dp"
        android:layout_marginEnd="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_wifi"
            style="@style/QuickButton"
            android:text="@string/wifi" />

        <TextView
            android:id="@+id/btn_bluetooth"
            style="@style/QuickButton"
            android:text="@string/bluetooth" />

        <TextView
            android:id="@+id/btn_projector"
            style="@style/QuickButton"
            android:text="@string/projector" />

        <TextView
            android:id="@+id/btn_settings"
            style="@style/QuickButton"
            android:text="@string/settings" />

        <TextView
            android:id="@+id/btn_launcher"
            style="@style/QuickButton"
            android:text="@string/launcher" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="@drawable/clock_pill"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Slides up when focus moves into "All apps"; see MainActivity.setDockExpanded. -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="38dp"
        android:paddingEnd="38dp"
        android:paddingBottom="20dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/favorites_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/favorites_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/favorites_hint"
            android:textColor="@color/text_secondary"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/all_apps_label"
            style="@style/SectionLabel"
            android:paddingStart="10dp"
            android:text="@string/all_apps" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/all_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>
