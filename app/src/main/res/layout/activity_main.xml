<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <!-- 48dp / 27dp padding keeps everything inside the TV-safe area on projectors with overscan. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="@color/text_primary"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="EEEE, MMMM d"
                    android:format24Hour="EEEE, MMMM d"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_wifi"
                style="@style/QuickButton"
                android:text="@string/wifi" />

            <TextView
                android:id="@+id/btn_bluetooth"
                style="@style/QuickButton"
                android:text="@string/bluetooth" />

            <TextView
                android:id="@+id/btn_display"
                style="@style/QuickButton"
                android:text="@string/display" />

            <TextView
                android:id="@+id/btn_settings"
                style="@style/QuickButton"
                android:text="@string/settings" />

            <TextView
                android:id="@+id/btn_launcher"
                style="@style/QuickButton"
                android:text="@string/launcher" />
        </LinearLayout>

        <TextView
            android:id="@+id/focused_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="24sp" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/favorites" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/favorites_row"
            android:layout_width="match_parent"
            android:layout_height="114dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <TextView
            android:id="@+id/favorites_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/favorites_hint"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            style="@style/SectionLabel"
            android:text="@string/all_apps" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/all_apps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="27dp" />
    </LinearLayout>
</FrameLayout>
